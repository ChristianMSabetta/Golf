# ─── Branding (used by src/lib/brand.ts) ────────────────────────────────────
# Public product name surfaced across all pages (never hardcoded in components).
NEXT_PUBLIC_PRODUCT_NAME=TeeBoard
# Public product domain used in links and metadata.
NEXT_PUBLIC_PRODUCT_DOMAIN=teeboard.golf
# Server-side sender email used for outgoing transactional email (M1-T003+).
SENDER_EMAIL=no-reply@teeboard.golf
# Public logo URL (served from /public or a CDN).
NEXT_PUBLIC_LOGO_URL=/logo.svg

# ─── Supabase (required from M1-T003 — waitlist persistence) ───────────────
# Project URL (Supabase dashboard → Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
# Anonymous public key; pairs with the insert-only RLS policy so unauthenticated
# clients can add signups but never read, update, or delete rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service-role key; bypasses RLS for trusted server code. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Resend (required from M1-T003 — admin notification email) ─────────────
# Resend API key (dashboard → API keys).
RESEND_API_KEY=
# Address that receives exactly one notification per waitlist signup.
ADMIN_NOTIFY_EMAIL=

# ─── Cal.com (required from M1-T004 — booking embed) ───────────────────────
# Cal.com event-type link for the embedded 15-minute booking widget.
NEXT_PUBLIC_CALCOM_EVENT_LINK=
